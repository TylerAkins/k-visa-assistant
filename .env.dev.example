# Deployment target: dev (shared staging on your domain, IP-restricted at the proxy)
APP_ENV=dev

# Node runtime mode (must be production for deployed environments)
NODE_ENV=production

# Public URL of the dev deployment (update when the domain is chosen)
APP_URL=https://dev.example.com

# Managed PostgreSQL connection string for the dev environment
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kvisaassistant

# Auth secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=
ENCRYPTION_KEY=

# Email provider: console | resend (future)
EMAIL_PROVIDER=console

# Optional comma-separated CIDR allowlist for dev access.
# NOT enforced yet — documented for Phase 9 (Caddy reverse proxy).
# DEV_ALLOWED_CIDRS=203.0.113.0/24,198.51.100.42/32
