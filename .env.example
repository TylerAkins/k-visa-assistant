# Deployment target: local (machine-only development)
APP_ENV=local

# Node runtime mode (development | test | production)
NODE_ENV=development

# Public URL of the app (used for links and callbacks)
APP_URL=http://localhost:3000

# PostgreSQL connection string (must match docker-compose.yml for local dev)
DATABASE_URL=postgresql://kvisaassistant:kvisaassistant@127.0.0.1:5432/kvisaassistant

# Auth secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=local-dev-session-secret-change-me-32chars
ENCRYPTION_KEY=local-dev-encryption-key-change-me-32ch

# Email provider: console (logs to terminal) | resend (future)
EMAIL_PROVIDER=console
