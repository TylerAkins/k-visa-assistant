# Deployment target: prod (customer-facing production)
APP_ENV=prod

# Node runtime mode (must be production for deployed environments)
NODE_ENV=production

# Public URL of the production app (update when the domain is chosen)
APP_URL=https://app.example.com

# Managed PostgreSQL connection string for production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kvisaassistant

# Future auth secret (Phase 1). Generate with: openssl rand -base64 32
# SESSION_SECRET=
